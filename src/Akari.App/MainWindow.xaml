<Window
    x:Class="Akari.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mu="using:Microsoft.UI.Xaml.Controls"
    Title="Akari Toolbox">

    <mu:NavigationView
        x:Name="RootNav"
        IsPaneVisible="True"
        IsPaneOpen="True"
        IsBackButtonVisible="Collapsed"
        IsBackEnabled="False"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavSelectionChanged">

        <mu:NavigationView.MenuItems>
            <mu:NavigationViewItem
                x:Name="TweaksNav"
                Content="Gaming Tweaks"
                IsSelected="True"
                Tag="Tweaks" />
            <mu:NavigationViewItem
                x:Name="SettingsNav"
                Content="Settings"
                Tag="Settings" />
        </mu:NavigationView.MenuItems>

        <mu:NavigationView.Content>
            <Frame x:Name="ContentFrame" />
        </mu:NavigationView.Content>

    </mu:NavigationView>
</Window>
